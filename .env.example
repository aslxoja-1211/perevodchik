# ==============================================
# Ovozli Tarjimon (Uzbek -> Russian Voice Translator)
# ==============================================

# Asosiy Provayderlar
STT_PROVIDER=gemini
TRANSLATION_PROVIDER=gemini
TTS_PROVIDER=edge_tts

# Gemini Sozlamalari
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI Sozlamalari (Ixtiyoriy)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Edge-TTS Ruscha Ovoz Sozlamalari
# Ayol ovozlari: ru-RU-SvetlanaNeural (tavsiya), ru-RU-EkaterinaNeural
# Erkak ovozlari: ru-RU-DmitryNeural (tavsiya)
DEFAULT_TTS_VOICE=ru-RU-SvetlanaNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Tarjima yo'nalishi (uz-ru | ru-uz)
DEFAULT_DIRECTION=uz-ru

# Server parametrlari
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
TIMEOUT_SECONDS=12.0
MAX_AUDIO_BYTES=10485760
